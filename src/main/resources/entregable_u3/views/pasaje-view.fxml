<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>
<VBox spacing="20.0" style="-fx-background-color: #F3F6FA"
      stylesheets="@style.css" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="entregable_u3.controller.PasajeController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>
    <children>
        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <Label text="Gestion de Pasajes" textFill="#0B2545">
                    <font><Font name="Georgia Bold" size="20.0"/></font>
                </Label>
                <Region HBox.hgrow="ALWAYS"/>
                <Button mnemonicParsing="false" onAction="#handleNew" styleClass="button-login" text="+ NUEVO"/>
            </children>
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Label text="Buscar por DNI" textFill="#4A5A6A"/>
                <TextField fx:id="txtBuscarDni" onKeyReleased="#buscarPorDni" promptText="Ingrese el DNI del pasajero" prefWidth="220.0"/>
            </children>
        </HBox>

        <TableView fx:id="tablePasaje" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="ColNumero" prefWidth="30" text="N°"/>
                <TableColumn fx:id="ColId" prefWidth="30" text="ID" visible="false"/>
                <TableColumn fx:id="ColCodigo" prefWidth="105" text="Codigo"/>
                <TableColumn fx:id="ColEmision" prefWidth="110" text="Emision"/>
                <TableColumn fx:id="ColPasajero" prefWidth="130" text="Pasajero"/>
                <TableColumn fx:id="ColDni" prefWidth="75" text="DNI"/>
                <TableColumn fx:id="ColComprador" prefWidth="130" text="Comprador"/>
                <TableColumn fx:id="ColViaje" prefWidth="130" text="Viaje"/>
                <TableColumn fx:id="ColSalida" prefWidth="110" text="Salida"/>
                <TableColumn fx:id="ColCosto" prefWidth="70" text="Costo (S/)"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
        <!--Acciones de la tabla -->
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Button mnemonicParsing="false" onAction="#handleDelete" styleClass="button-action-delete" text="ELIMINAR"/>
            </children>
        </HBox>
    </children>

</VBox>

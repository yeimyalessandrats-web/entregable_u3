<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>
<VBox spacing="20.0" style="-fx-background-color: #F3F6FA"
      stylesheets="@style.css" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="entregable_u3.controller.ViajeController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>
    <children>
        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <Label text="Gestion de Viajes" textFill="#0B2545">
                    <font><Font name="Georgia Bold" size="20.0"/></font>
                </Label>
                <Region HBox.hgrow="ALWAYS"/>
                <Button mnemonicParsing="false" onAction="#handleNew" styleClass="button-login" text="+ NUEVO"/>
            </children>
        </HBox>

        <TableView fx:id="tableViaje" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="ColNumero" prefWidth="30" text="N°"/>
                <TableColumn fx:id="ColId" prefWidth="30" text="ID" visible="false"/>
                <TableColumn fx:id="ColOrigen" prefWidth="100" text="Origen"/>
                <TableColumn fx:id="ColDestino" prefWidth="100" text="Destino"/>
                <TableColumn fx:id="ColSalida" prefWidth="130" text="Salida (fecha y hora)"/>
                <TableColumn fx:id="ColLlegada" prefWidth="130" text="Llegada (fecha y hora)"/>
                <TableColumn fx:id="ColConductor" prefWidth="140" text="Conductor"/>
                <TableColumn fx:id="ColVehiculo" prefWidth="160" text="Vehiculo"/>
                <TableColumn fx:id="ColPrecio" prefWidth="80" text="Precio (S/)"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
        <!--Acciones de la tabla -->
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Button mnemonicParsing="false" onAction="#handleEdit" styleClass="button-action-edit" text="EDITAR"/>
                <Button mnemonicParsing="false" onAction="#handleDelete" styleClass="button-action-delete" text="ELIMINAR"/>
            </children>
        </HBox>
    </children>

</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>
<VBox spacing="20.0" style="-fx-background-color: white" stylesheets="@style.css"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="entregable_u3.controller.ViajeRealFormController">
    <padding>
        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0"/>
    </padding>
    <children>
        <Label fx:id="lblTitulo" text="Registrar salida real" textFill="#0B2545">
            <font><Font name="Georgia Bold" size="18.0"/></font>
        </Label>
        <Separator prefWidth="200.0"/>
        <GridPane hgap="10.0" vgap="15.0">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="130.0"/>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="280.0"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
            </rowConstraints>
            <children>
                <Label text="Viaje"/>
                <Label fx:id="lblViaje" text="-" textFill="#0B2545" GridPane.columnIndex="1"/>
                <Label text="Programado" GridPane.rowIndex="1"/>
                <Label fx:id="lblProgramado" text="-" textFill="#0B2545" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <Label fx:id="lblTextoFecha" text="Fecha de salida" GridPane.rowIndex="2"/>
                <DatePicker fx:id="dpFecha" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                <Label fx:id="lblTextoHora" text="Hora de salida" GridPane.rowIndex="3"/>
                <TextField fx:id="txtHora" promptText="HH:mm (ejemplo 06:45)" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
            </children>
        </GridPane>
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Button mnemonicParsing="false" onAction="#handleCancel" prefHeight="31.0"
                        prefWidth="100.0" styleClass="button-action-delete" text="Cancelar"/>
                <Button mnemonicParsing="false" onAction="#handleSave" prefHeight="31.0"
                        prefWidth="100.0" styleClass="button-action-edit" text="Guardar"/>
            </children>
        </HBox>
    </children>

</VBox>
